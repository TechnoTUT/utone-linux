[Unit]
Description=NDI Receiver (SDL2)
After=network.target

[Service]
ExecStart=/opt/moip-toolkit/.venv/bin/python /opt/moip-toolkit/rx.py -s "__SOURCE_NAME__" --fullscreen
WorkingDirectory=/opt/moip-toolkit
Restart=always
RestartSec=3
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=default.target