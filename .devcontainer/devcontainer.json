{
  "name": "utone-linux",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "privileged": true,
  "remoteUser": "vscode",
  "postCreateCommand": "git submodule update --init --recursive",
  "customizations": {
    "vscode": {
      "extensions": [
        "timonwong.shellcheck",
        "foxundermoon.shell-format"
      ]
    }
  }
}
